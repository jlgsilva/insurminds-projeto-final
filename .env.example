# ==========================================================================
# AgroSentinela — variáveis de ambiente
#
# Copie para `.env` e preencha. O arquivo `.env` está no .gitignore e
# NUNCA deve ser versionado.
#
#   cp .env.example .env
#
# No Streamlit Community Cloud, informe os mesmos valores em
# Settings → Secrets, no formato TOML:
#
#   GROQ_API_KEY = "gsk_..."
# ==========================================================================

# --------------------------------------------------------------------------
# IA Generativa — GroqCloud (camada gratuita)
# Crie a chave em https://console.groq.com/keys
# Sem ela o sistema continua funcionando, com o redator determinístico.
# --------------------------------------------------------------------------
GROQ_API_KEY=

# Modelos (ver https://console.groq.com/docs/models)
GROQ_MODEL_REDACAO=openai/gpt-oss-120b
GROQ_MODEL_RAPIDO=openai/gpt-oss-20b
GROQ_MODEL_COPILOTO=openai/gpt-oss-120b

# Parâmetros de geração
LLM_TEMPERATURA=0.35
LLM_MAX_TOKENS=2048
LLM_REASONING_EFFORT=low
GROQ_MODEL_EXTRACAO=openai/gpt-oss-120b
LLM_TIMEOUT_S=45
LLM_MAX_RETRIES=3

# Guarda-corpos da camada gratuita
LLM_CACHE_ATIVO=true
LLM_MAX_CHAMADAS_POR_RUN=40

# --------------------------------------------------------------------------
# Clima — Open-Meteo (pública, sem chave)
# --------------------------------------------------------------------------
DIAS_PREVISAO=10
CLIMA_MAX_MUNICIPIOS=250
TIMEZONE=America/Sao_Paulo

# --------------------------------------------------------------------------
# Dados
#   auto     → usa os curados do BCB se existirem, senão a amostra de demonstração
#   curated  → exige os dados curados (rode o ETL antes)
#   seed     → força a amostra de demonstração
# --------------------------------------------------------------------------
FONTE_DADOS=auto

# --------------------------------------------------------------------------
# Operação
# --------------------------------------------------------------------------
LOG_LEVEL=INFO
MODO_SIMULACAO=true
